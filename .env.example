# Open MarketingOps - Environment Configuration
# Copy this file to .env.local for local overrides

# Application Mode
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase Database Connection
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional AI Provider API Keys (Leave blank to use deterministic offline mode)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional Meta Marketing API (Future integration)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/meta/callback

